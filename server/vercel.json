{
  "version": 2,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/[...path]"
    },
    {
      "source": "/events",
      "destination": "/api/[...path]"
    },
    {
      "source": "/kv",
      "destination": "/api/[...path]"
    },
    {
      "source": "/kv/:path*",
      "destination": "/api/[...path]"
    }
  ]
}